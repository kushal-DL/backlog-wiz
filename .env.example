# Smart Backlog Assistant — environment variables
# Copy this file to .env and fill in MODEL_KEY before running.

# Required: API key for the LLM endpoint
MODEL_KEY=your_api_key_here

# Required: OpenAI-compatible base URL
MODEL_URL=https://integrate.api.nvidia.com/v1

# Required: model identifier
MODEL_NAME=nvidia/nemotron-3.5-lightning-30b-a3b
